rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  FUNÇÕES AUXILIARES                                                 ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    /// Autenticado com email disponível.
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    /// AUTORIZADO: tem role em pelo menos um grupo Harpia.
    /// Isto é: o mapa harpia_roles existe e não é vazio.
    /// Cobre: participantes, administradores, proprietários e metausuários.
    function isAutorizado() {
      return isAuthenticated()
        && request.auth.token.harpia_roles is map
        && request.auth.token.harpia_roles.size() > 0;
    }

    /// OBSERVÁVEL: é MEMBER ou MANAGER em pelo menos um grupo.
    /// Pode escrever sua própria localização.
    ///
    /// Nota: proprietários (OWNER) e metausuários (METAUSER) NÃO são
    /// observáveis — coerente com as propriedades (a) e (b) da especificação.
    ///
    /// A verificação é system-wide (não per-group) porque a coleção
    /// `usuarios` é flat e não está particionada por grupo.
    function isObservavel() {
      return isAuthenticated()
        && request.auth.token.harpia_roles is map
        && request.auth.token.harpia_roles.values().hasAny(["MEMBER", "MANAGER"]);
    }

    /// O email do token corresponde ao ID do documento (coleção `usuarios`).
    function isDocOwner(docEmail) {
      return request.auth.token.email == docEmail;
    }

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  COLEÇÃO: usuarios/{email}                                          ║
    // ║                                                                     ║
    // ║  Localização em tempo real. DocId = email do usuário.                ║
    // ║  Campos: email, nome, lat, lng, timestamp, isTracked                ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    match /usuarios/{usuarioEmail} {

      // ── LEITURA ─────────────────────────────────────────────────────────
      // Qualquer AUTORIZADO pode ler.
      // A filtragem por grupo (quais marcadores exibir) é feita pelo
      // cliente via Google Groups API — o Firestore não tem visibilidade
      // sobre qual grupo o usuário está observando.
      //
      // Isto implementa: propriedades (a), (b) e (c) — todo usuário de
      // um grupo é observador, e todo observador pode ler.
      allow read: if isAutorizado();

      // ── CRIAÇÃO ─────────────────────────────────────────────────────────
      // Apenas OBSERVÁVEIS podem criar seu próprio documento.
      // A coleção `usuarios` existe exclusivamente para armazenar
      // coordenadas de usuários observáveis. Proprietários e metausuários
      // não precisam (e não devem) ter um documento aqui.
      //
      // Restrições:
      //   - Deve ser observável (MEMBER/MANAGER em algum grupo)
      //   - O docId (usuarioEmail) deve ser o email do token
      //   - O campo `email` no documento deve coincidir com o email do token
      //   - Apenas campos permitidos
      allow create: if isObservavel()
        && isDocOwner(usuarioEmail)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(
             ['email', 'nome', 'lat', 'lng', 'timestamp', 'isTracked']
           );

      // ── ATUALIZAÇÃO ─────────────────────────────────────────────────────
      // Um OBSERVÁVEL pode atualizar APENAS seu próprio documento.
      //
      // Restrições:
      //   - Só quem é observável (MEMBER/MANAGER em algum grupo) pode atualizar
      //     (proprietários e metausuários NÃO — propriedade b)
      //   - Apenas o próprio documento (docId == email do token)
      //   - O campo `email` é imutável
      //   - Apenas campos permitidos
      //
      // Isto implementa:
      //   - Propriedade (a): participante/admin → observável → pode escrever
      //   - Propriedade (b): proprietário → NÃO observável → NÃO pode escrever
      //   - Metausuário ≡ proprietário (Obs3) → NÃO pode escrever
      allow update: if isObservavel()
        && isDocOwner(usuarioEmail)
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(
             ['email', 'nome', 'lat', 'lng', 'timestamp', 'isTracked']
           );

      // ── EXCLUSÃO ────────────────────────────────────────────────────────
      // Exclusão de documentos em `usuarios` é proibida.
      // Dados de localização devem ser preservados.
      allow delete: if false;

      // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
      // SUBCOLEÇÃO: historico_posicoes/{pontoId}
      //
      // Pontos GPS históricos (append-only). Escritos pelo foreground
      // service em updateLocationAndTimestamp().
      // Campos: lat, lng, timestamp
      // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

      match /historico_posicoes/{pontoId} {

        // Qualquer autorizado pode ler histórico (mesmo de outros usuários,
        // pois o app exibe trajetórias de membros observados).
        allow read: if isAutorizado();

        // Apenas o próprio observável pode criar pontos no SEU histórico.
        // Impede falsificação de trajetória de outro usuário.
        //
        // Validação: campos obrigatórios e tipos corretos.
        allow create: if isObservavel()
          && isDocOwner(usuarioEmail)
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'timestamp'])
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.timestamp is timestamp;

        // Histórico é imutável (append-only): não permite update nem delete.
        allow update, delete: if false;
      }
    }

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  COLEÇÃO: users/{uid}                                               ║
    // ║                                                                     ║
    // ║  Perfil Google do usuário (criado no login).                         ║
    // ║  DocId = Firebase Auth UID.                                         ║
    // ║  Campos: name, email, urlImage, createdAt, avatarBase64             ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    match /users/{userId} {

      // Qualquer autenticado pode ler perfis (necessário para exibir
      // nomes e avatares de outros usuários no mapa).
      allow read: if isAuthenticated();

      // O usuário pode criar/atualizar apenas seu próprio perfil.
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'urlImage', 'createdAt', 'avatarBase64']
           );

      // Exclusão de perfis é proibida.
      allow delete: if false;
    }

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  DEFAULT: negar tudo que não foi explicitamente permitido            ║
    // ║                                                                     ║
    // ║  NÃO HÁ match /{document=**}. O Firestore nega por padrão.          ║
    // ╚══════════════════════════════════════════════════════════════════════╝
  }
}
